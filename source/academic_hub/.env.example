# Copy to .env and fill in. The web container reads this file via
# docker-compose (env_file: .env). Never commit the real .env.
#
#   cp .env.example .env

# Django. Generate a fresh key for anything that is not local development:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-generated-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database. Must match the db service in docker-compose.yml.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Google OAuth. Leave blank to disable that sign-in path; Nisit ID and
# password sign-in keeps working either way.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/accounts/oauth/google/callback/

# Password reset and email. Leave EMAIL_BACKEND as console for local testing.
# When ready to deploy, change EMAIL_BACKERND to actual email -> SMTP/email provider
PASSWORD_RESET_BASE_URL=http://localhost:8000
PASSWORD_RESET_TIMEOUT_MINUTES=30
PASSWORD_RESET_REQUEST_LIMIT=5
PASSWORD_RESET_REQUEST_WINDOW=3600
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=webmaster@localhost

MAX_UPLOAD_MB=50

# Shorts clip storage (MinIO). docker-compose already sets SHORTS_STORAGE=minio
# and the connection for the web container, and uses these defaults if you
# leave the lines below commented out. Change them for anything that is not
# local development. The MinIO console is at http://localhost:9001.
# MINIO_ROOT_USER=bnm-minio
# MINIO_ROOT_PASSWORD=bnm-minio-dev-password
# Outside Docker, clips are saved under media/shorts unless you set:
# SHORTS_STORAGE=minio
# MINIO_ENDPOINT_URL=http://localhost:9000
# MINIO_ACCESS_KEY=bnm-minio
# MINIO_SECRET_KEY=bnm-minio-dev-password
# Largest clip upload, in MB (clips are also limited to 1:30 in length).
SHORTS_MAX_UPLOAD_MB=100
